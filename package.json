{
  "name": "pi-threadshift",
  "version": "0.1.0-beta.2",
  "packageManager": "pnpm@11.5.2",
  "description": "Threadshift preserves working context and carries it into a fresh Pi session before the window becomes crowded.",
  "author": "Rajyavardhan Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imrajyavardhan12/pi-threadshift.git"
  },
  "bugs": {
    "url": "https://github.com/imrajyavardhan12/pi-threadshift/issues"
  },
  "homepage": "https://github.com/imrajyavardhan12/pi-threadshift#readme",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "handoff",
    "context-window"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "files": [
    "extensions",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.23.2 <23 || >=24.18.1"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm release:check",
    "release:check": "pnpm check && pnpm test && pnpm smoke && pnpm audit --prod",
    "smoke": "pi --no-extensions -e . --list-models gpt-5.6-sol",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": [
      "./extensions/threadshift.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.1 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
